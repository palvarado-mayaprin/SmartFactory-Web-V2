    "ask": [
      "Bash(git * commit*)",
      "Bash(git * push*)",
      "Bash(git * add*)",
      "Bash(git * checkout*)",
      "Bash(git * reset*)",
      "Bash(git * stash*)",
      "Bash(git config*)",
      "Bash(*pip install*)",
      "Edit(db/**)",
      "Edit(config.py)",
      "Edit(main.py)",
      "Edit(.env.*)",
      "Edit(*.bat)",
      "Edit(.gitignore)",
      "Edit(requirements*.txt)",
      "Edit(pytest.ini)",
      "Edit(huella_local/**)",
      "Edit(services/mqtt_service.py)",
