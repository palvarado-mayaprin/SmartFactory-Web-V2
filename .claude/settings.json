{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv-test/Scripts/python.exe -m pytest*)",
      "Bash(.venv-test/Scripts/python.exe -m py_compile *)",
      "Bash(venv/Scripts/python.exe -m py_compile *)",
      "Bash(git -c safe.directory=D:/VSCODE/SMARTFACTORY/src_web status*)",
      "Bash(git -c safe.directory=D:/VSCODE/SMARTFACTORY/src_web diff*)",
      "Bash(git -c safe.directory=D:/VSCODE/SMARTFACTORY/src_web log*)",
      "Bash(git -c safe.directory=D:/VSCODE/SMARTFACTORY/src_web show*)",
      "Bash(git -c safe.directory=D:/VSCODE/SMARTFACTORY/src_web blame*)",
      "Edit(api/**)",
      "Edit(services/**)",
      "Edit(models/**)",
      "Edit(realtime/**)",
      "Edit(static/**)",
      "Edit(templates/**)",
      "Edit(tests/**)",
      "Edit(docs/ai/*.md)",
      "Edit(CLAUDE.md)"
