    "deny": [
      "Bash(*uvicorn*)",
      "PowerShell(*uvicorn*)",
      "Bash(*.bat*)",
      "PowerShell(*.bat*)",
      "Bash(cmd *)",
      "Bash(*mysql -*)",
      "PowerShell(*mysql -*)",
      "Bash(*mosquitto*)",
      "Bash(git * push --force*)",
      "Bash(git config --global*)",
      "Read(.env)",
      "Edit(.env)",
      "Edit(logs/**)",
      "Edit(cambios_*.diff)",
      "Edit(resumen_cambios.txt)",
      "Edit(venv/**)"
    ]
