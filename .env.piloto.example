# ============================================================
# SMARTFACTORY WEB - CONFIGURACIÓN PILOTO
# Copia este archivo como .env.piloto si deseas usarlo como referencia.
# Los scripts .bat ya configuran estas variables para la primera versión funcional.
# ============================================================

# Escritura real de marcajes en BD
SMARTFACTORY_ENABLE_REAL_DB_WRITES=1

# Escritura real de mensajes MQTT en mensajes_mqtt y datossensados
SMARTFACTORY_ENABLE_REAL_MQTT_DB_WRITES=1

# Publicación MQTT real hacia ESP para inicio/cierre de actividad
SMARTFACTORY_ENABLE_REAL_MQTT_PUBLISH=1

# Servicio local de huella
SMARTFACTORY_HUELLA_MODO=REAL
SMARTFACTORY_HUELLA_HOST=127.0.0.1
SMARTFACTORY_HUELLA_PORT=8888
SMARTFACTORY_HUELLA_COMANDO=enrollFingerPrint
SMARTFACTORY_HUELLA_REINICIAR_EXE_ANTES_LECTURA=1
SMARTFACTORY_HUELLA_TIMEOUT_SEGUNDOS=30

# Puertos FastAPI
SMARTFACTORY_BACKEND_HOST=127.0.0.1
SMARTFACTORY_BACKEND_PORT=8000
SMARTFACTORY_HUELLA_LOCAL_HOST=127.0.0.1
SMARTFACTORY_HUELLA_LOCAL_PORT=9001
